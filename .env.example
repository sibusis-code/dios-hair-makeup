# Copy values into your hosting environment variables or into your server config.
# Do not commit real credentials.

DB_HOST=127.0.0.1
DB_NAME=dios_salon
DB_USER=dios_user
DB_PASS=change_me

PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=replace_with_key
PAYFAST_SANDBOX=true
PAYFAST_PASSPHRASE=

# Optional fallback deposit amount (in ZAR) for services not in the price map.
# Individual service prices are defined in config.php getServicePriceMap().
BOOKING_DEPOSIT_AMOUNT=500.00

# Optional if auto-detect is not correct.
SITE_URL=

# Optional explicit ITN URL. Recommended on production.
PAYFAST_NOTIFY_URL_OVERRIDE=
